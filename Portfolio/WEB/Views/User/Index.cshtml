<!-- Model Declaration -->
@model IPagedList<Entity.Business_Entity.UserDTO>
@using Entity.Business_Entity;
@using X.PagedList
@using X.PagedList.Mvc.Core

@{
    ViewData["Title"] = "All Users";
}

<br />
<br />

<h2 class="mb-3">All Registered Users</h2>

<!-- Search form -->
<form asp-action="Index" method="post" class="mb-3">
    <div class="input-group">
        <input type="text" name="userName" class="form-control" placeholder="Search by Username..." />
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<!-- Table -->
<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>User ID</th>
            <th>User Name</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var user in Model)
            {
                <tr>
                    <td>@user.UserId</td>
                    <td>@user.UserName</td>
                    <td>@user.Email</td>
                    <td>
                        <a asp-controller="User" asp-action="FullUserDetails" asp-route-userId="@user.UserId" class=" btn btn-outline-secondary btn-sm">See Details</a>
                        <a asp-controller="UserDetails" asp-action="EditDetails" asp-route-userId="@user.UserId" class=" btn btn-outline-secondary btn-sm">Edit</a>
                        <a asp-controller="UserDetails" asp-action="Delete" asp-route-userId="@user.UserId" class=" btn btn-outline-secondary btn-sm">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No users found.</td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination (only for GET Index with IPagedList) -->

    <div class="text-center mt-3">
    <!-- PagedListPager is a helper method in Razor views (HTML) to render pagination links (Prev, Next, page numbers).-->
        @Html.PagedListPager((IPagedList<UserDTO>)Model, page => Url.Action("Index", new { page }),
    new PagedListRenderOptions
    {
    DisplayLinkToFirstPage = PagedListDisplayMode.Always,
    DisplayLinkToLastPage = PagedListDisplayMode.Always,
    DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
    DisplayLinkToNextPage = PagedListDisplayMode.Always,
    DisplayLinkToIndividualPages = true,
    MaximumPageNumbersToDisplay = 5,
    UlElementClasses = new[] { "pagination justify-content-center" },
    LiElementClasses = new[] { "page-item" },
    PageClasses = new[] { "page-link" }
    })
    </div>
